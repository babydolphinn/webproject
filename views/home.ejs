<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>College Project Hub - Home</title>
    <!-- CSS for Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">

    <!-- This is the Navbar (The Menu) -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
      <div class="container">
        <a class="navbar-brand" href="/">ProjectHub</a>
        <div class="navbar-nav">
          <a class="nav-link active" href="/">Home</a>
          <a class="nav-link" href="/add">Add New Project</a>
          <form action="/logout" method="GET" class="ms-3">
                <button type="submit" class="logout-btn">
                    Sign Out
                </button>
            </form>
        </div>
      </div>
    </nav>

    <style>
.logout-btn {
    background-color: #ff4d4d;
    color: white;
    border: none;
    padding: 7px 16px;
    border-radius: 5px;
    cursor: pointer;
    font-size: 14px;
    font-weight: bold;
    transition: 0.3s;
}

.logout-btn:hover {
    background-color: #e60000;
}
</style>

    <!-- Main Content Container -->
    <div class="container mt-5">
        <h1 class="text-center mb-4">Graduation Projects Repository</h1>
        
        <div class="row">
            <% if (projects && projects.length > 0) { %>
                <% projects.forEach(project => { %>
                    <div class="col-md-4 mb-4">
                        <div class="card h-100 shadow-sm">
                            <div class="card-body d-flex flex-column">
                                <h5 class="card-title"><%= project.title %></h5>
                                <!-- Using your class method -->
                                <h6 class="card-subtitle mb-2 text-muted"><%= project.getFormattedCategory() %></h6>
                                <p class="card-text"><%= project.getSnippet() %></p>
                                
                                <!-- Critical Fix: Ensuring the ID is attached correctly[cite: 2] -->
                                <div class="mt-auto">
                                    <a href="/project/<%= project._id %>" class="btn btn-primary w-100">View Details</a>
                                </div>
                            </div>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <div class="col-12 text-center">
                    <p class="text-muted">No projects available at the moment.</p>
                </div>
            <% } %>
        </div>
    </div>

    <!-- Bootstrap Script -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
