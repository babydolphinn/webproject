<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>College Project Hub - Home</title>
    <!-- CSS for Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">

    <!-- This is the Navbar (The Menu) -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
      <div class="container">
        <a class="navbar-brand" href="/">ProjectHub</a>
        <div class="navbar-nav">
          <a class="nav-link active" href="/">Home</a>
          <!-- Link for Student 3's task -->
          <a class="nav-link" href="/add">Add New Project</a>
        </div>
      </div>
    </nav>

    <!-- Main Content Container -->
    <div class="container mt-5">
        <h1 class="text-center mb-4">Graduation Projects Repository</h1>
        
        <!-- The Row where cards will live -->
        <div class="row">
    <% if (projects.length > 0) { %>
        <% projects.forEach(project => { %>
            <!-- This is where Student 2's "Read" logic happens -->
            <div class="col-md-4 mb-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h5 class="card-title"><%= project.title %></h5>
                        <p class="text-muted"><%= project.category %></p>
                        <a href="/project/<%= project._id %>" class="btn btn-primary">View Details</a>
                    </div>
                </div>
            </div>
        <% }) %>
    <% } else { %>
        <p>No projects found. Be the first to add one!</p>
    <% } %>
         </div>
    </div>

    <!-- Bootstrap Script (Place this before the closing body tag) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>