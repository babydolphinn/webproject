<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>College Project Hub - Home</title>
    <!-- CSS for Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">

    <!-- This is the Navbar (The Menu) -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
      <div class="container">
        <a class="navbar-brand" href="/">ProjectHub</a>
        <div class="navbar-nav">
          <a class="nav-link active" href="/">Home</a>
          <!-- Link for Student 3's task -->
          <a class="nav-link" href="/add">Add New Project</a>
        </div>
      </div>
    </nav>

    <!-- Main Content Container -->
    <div class="container mt-5">
        <h1 class="text-center mb-4">Graduation Projects Repository</h1>
        
        <!-- The Row where cards will live -->
        <div class="row">
    <% projects.forEach(project => { %>
        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title"><%= project.title %></h5>
                    <h6 class="card-subtitle mb-2 text-muted"><%= project.category %></h6>
                    <p class="card-text"><%= project.shortDescription %></p>
                    <!-- This link will eventually be dynamic -->
                    <a href="/details" class="btn btn-primary w-100">View Details</a>
                </div>
            </div>
        </div>
    <% }) %>
</div>
    </div>

    <!-- Bootstrap Script (Place this before the closing body tag) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>