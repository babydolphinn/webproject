<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Project</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" href="/">ProjectHub</a>
            <div class="navbar-nav">
                <a class="nav-link" href="/">Home</a>
            </div>
        </div>
    </nav>
    <div class="container mt-5">
        <div class="card shadow p-4">
            <h2 class="mb-4">Edit Project</h2>
            <form action="/project/<%= project._id %>/edit" method="POST">
                <div class="mb-3">
                    <label class="form-label">Project Title</label>
                    <input type="text" name="title" class="form-control" value="<%= project.title %>" required>
                </div>
                <div class="mb-3">
                    <label class="form-label">Category</label>
                    <select name="category" class="form-select" required>
                        <option value="Artificial Intelligence" <%= project.category === 'Artificial Intelligence' ? 'selected' : '' %>>Artificial Intelligence</option>
                        <option value="Web Development" <%= project.category === 'Web Development' ? 'selected' : '' %>>Web Development</option>
                        <option value="Mobile Development" <%= project.category === 'Mobile Development' ? 'selected' : '' %>>Mobile Development</option>
                        <option value="Cybersecurity" <%= project.category === 'Cybersecurity' ? 'selected' : '' %>>Cybersecurity</option>
                        <option value="Data Science" <%= project.category === 'Data Science' ? 'selected' : '' %>>Data Science</option>
                        <option value="Other" <%= project.category === 'Other' ? 'selected' : '' %>>Other</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">Short Description</label>
                    <input type="text" name="shortDescription" class="form-control" value="<%= project.shortDescription %>" required>
                </div>
                <div class="mb-3">
                    <label class="form-label">Full Description</label>
                    <textarea name="fullDescription" class="form-control" rows="4" required><%= project.fullDescription %></textarea>
                </div>
                <div class="mb-3">
                    <label class="form-label">Your Experience & Advice</label>
                    <textarea name="experience" class="form-control" rows="3" required><%= project.experience %></textarea>
                </div>
                <button type="submit" class="btn btn-warning w-100">Update Project</button>
            </form>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>