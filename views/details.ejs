<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Project Details</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
      <div class="container">
        <a class="navbar-brand" href="/">ProjectHub</a>
        <div class="navbar-nav">
          <a class="nav-link" href="/">Home</a>
        </div>
      </div>
    </nav>
    <div class="container mt-5">
        <div class="card shadow p-4">
            <h1 class="display-4"><%= project.title %></h1>
            <span class="badge bg-secondary mb-3"><%= project.category %></span>
            <hr>
            <h3>Project Description</h3>
            <p class="lead"><%= project.fullDescription %></p>
            <div class="alert alert-info mt-4">
                <h4>Student Experience & Advice</h4>
                <p><%= project.experience %></p>
            </div>
            <div class="mt-4 d-flex gap-2">
                <a href="/project/<%= project._id %>/edit" class="btn btn-warning">Edit Project</a>
                <form action="/project/<%= project._id %>/delete" method="POST">
                    <button type="submit" class="btn btn-danger" onclick="return confirm('Are you sure?')">Delete Project</button>
                </form>
            </div>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>