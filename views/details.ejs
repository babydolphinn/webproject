<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Project Details</title>
    <!-- Bootstrap Link -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
      <div class="container">
        <a class="navbar-brand" href="/">ProjectHub</a>
        <div class="navbar-nav">
          <a class="nav-link" href="/">Home</a>
        </div>
      </div>
    </nav>

    <div class="container mt-5">
        <div class="card shadow p-4">
            <!-- Title and Category (Task 2 Req)[cite: 2] -->
            <h1 class="display-4">Project Title Placeholder</h1>
            <span class="badge bg-secondary mb-3">Category Placeholder</span>
            
            <hr>

            <!-- Project Description (Task 2 Req)[cite: 2] -->
            <h3>Project Description</h3>
            <p class="lead">This is where the full details of the project will be displayed[cite: 2].</p>

            <!-- Student Experience (Task 2 Req)[cite: 2] -->
            <div class="alert alert-info mt-4">
                <h4>Student Experience & Advice</h4>
                <p>This section will show what the student learned and their tips for others[cite: 2].</p>
            </div>

            <!-- Edit/Delete Buttons (Task 2 Req)[cite: 2] -->
            <div class="mt-4">
                <button class="btn btn-warning">Edit Project</button>
                <button class="btn btn-danger" onclick="return confirm('Are you sure?')">Delete Project</button>
            </div>
        </div>
    </div>

</body>
</html>