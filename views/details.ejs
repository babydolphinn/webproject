<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Project Details</title>
    <!-- Bootstrap Link -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
      <div class="container">
        <a class="navbar-brand" href="/">ProjectHub</a>
        <div class="navbar-nav">
          <a class="nav-link" href="/">Home</a>
        </div>
      </div>
    </nav>

    <div class="container mt-5">
        <div class="card shadow p-4">
            <!-- Dynamic Title and Category -->
            <h1 class="display-4"><%= project.title %></h1>
            <span class="badge bg-secondary mb-3"><%= project.category %></span>
            
            <hr>

            <!-- Dynamic Project Description -->
            <h3>Project Description</h3>
            <p class="lead"><%= project.fullDescription %></p>

            <!-- Dynamic Student Experience -->
            <div class="alert alert-info mt-4">
                <h4>Student Experience & Advice</h4>
                <p><%= project.experience %></p>
            </div>

            <!-- Edit/Delete Buttons (Task 2 Req)[cite: 2] -->
            <!-- These are visible for now, but Student 1 will later help hide them if not logged in[cite: 2] -->
            <div class="mt-4 d-flex gap-2">
    <a href="/project/<%= project._id %>/edit" class="btn btn-warning">Edit Project</a>

    <form action="/project/<%= project._id %>/delete" method="POST" onsubmit="return confirm('Are you sure you want to delete this project?')">
        <button type="submit" class="btn btn-danger">Delete Project</button>
    </form>
</div>
        </div>
    </div>

    <!-- Bootstrap Script -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>